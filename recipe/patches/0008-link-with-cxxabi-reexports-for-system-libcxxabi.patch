From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Isuru Fernando <isuruf@gmail.com>
Date: Tue, 3 Nov 2026 10:00:00 -0700
Subject: [PATCH 8/8] link with cxxabi-reexports for system-libcxxabi

---
 libcxx/cmake/Modules/HandleLibCXXABI.cmake | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/libcxx/cmake/Modules/HandleLibCXXABI.cmake b/libcxx/cmake/Modules/HandleLibCXXABI.cmake
index f823db8..f701695 100644
--- a/libcxx/cmake/Modules/HandleLibCXXABI.cmake
+++ b/libcxx/cmake/Modules/HandleLibCXXABI.cmake
@@ -168,6 +168,12 @@ elseif ("${LIBCXX_CXX_ABI}" STREQUAL "system-libcxxabi")
   import_shared_library(libcxx-abi-shared c++abi)
   target_link_libraries(libcxx-abi-shared INTERFACE libcxx-abi-headers)
 
+  # Re-export the libc++abi symbols like we do for the in-tree libc++abi, so
+  # that consumers linking only against libc++ still see them.
+  if (TARGET cxxabi-reexports)
+    target_link_libraries(libcxx-abi-shared INTERFACE cxxabi-reexports)
+  endif()
+
   import_static_library(libcxx-abi-static "${LIBCXX_CXX_ABI_LIBRARY_PATH}" c++abi)
   target_link_libraries(libcxx-abi-static INTERFACE libcxx-abi-headers)
 
